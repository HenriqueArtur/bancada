/target
**/node_modules
/dist
.DS_Store
/crates/**/target
/web/dist
/app/node_modules

# archwarden keeps a parse cache here; it is machine-local state. The
# decision documents under it are generated *and* committed — they are the
# rendering of what the config declares, with a region each that belongs to
# whoever opens them.
.archwarden/*
!.archwarden/decisions/

# lockfiles come from bun; npm must not leave a second, disagreeing one
package-lock.json

# Coverage. Written by every test run, and large.
/web/coverage/
*.profraw
/target/llvm-cov-target/

# tsc's incremental cache. It is written by `tsc --noEmit`, so it reappears
# on every run of the gate — tracked, it would make a clean tree look dirty.
web/tsconfig.tsbuildinfo

# tools/ holds a couple of python generators; their bytecode is not ours.
__pycache__/
